<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base app theme; Compose drives all visual styling, so this only needs to be a no-action-bar Material 3 shell. -->
    <style name="Theme.HoundHabit" parent="Theme.Material3.DayNight.NoActionBar" />

    <!-- Splash screen theme used as the launcher theme; swapped to Theme.HoundHabit after onCreate. -->
    <style name="Theme.HoundHabit.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.HoundHabit</item>
    </style>
</resources>
